{
	"name": "@config/eslint",
	"version": "1.0.1",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.ts",
			"default": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"publishConfig": {
		"directory": "dist"
	},
	"scripts": {
		"build": "tsup",
		"eslint": "NODE_OPTIONS='--experimental-specifier-resolution=node' pnpm exec eslint .",
		"eslint-fix": "NODE_OPTIONS='--experimental-specifier-resolution=node' pnpm exec eslint . --fix",
		"preinstall": "turbo run build --output-logs=errors-only",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@babel/eslint-parser": "7.24.7",
		"@babel/preset-env": "7.24.7",
		"@eslint/js": "9.6.0",
		"@next/eslint-plugin-next": "14.2.4",
		"eslint": "9.6.0",
		"eslint-config-next": "14.2.4",
		"eslint-config-prettier": "9.1.0",
		"@eslint/compat": "1.1.0",
		"eslint-config-turbo": "2.0.6",
		"eslint-import-resolver-typescript": "3.6.1",
		"eslint-plugin-file-extension-in-import-ts": "2.1.0",
		"eslint-plugin-import": "2.29.1",
		"eslint-plugin-prettier": "5.1.3",
		"eslint-plugin-react": "7.34.3",
		"eslint-plugin-tsdoc": "0.3.0",
		"eslint-plugin-turbo": "2.0.6",
		"typescript-eslint": "npm:typescript-eslint@rc-v8",
		"globals": "15.8.0",
		"next": "14.2.4",
		"prettier": "3.3.2",
		"@types/eslint": "8.56.10",
		"@types/eslint__js": "8.42.3",
		"stylelint": "16.6.1"
	},
	"devDependencies": {
		"@config/tsconfig": "workspace:*"
	}
}
