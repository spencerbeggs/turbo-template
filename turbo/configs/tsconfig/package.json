{
	"name": "@config/tsconfig",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./base.json": "./base.json",
		"./commonjs.json": "./commonjs.json",
		"./ecma.json": "./ecma.json",
		"./nextjs.json": "./nextjs.json",
		"./react-library.json": "./react-library.json"
	},
	"files": [
		"base.json",
		"commonjs.json",
		"ecma.json",
		"nextjs.json",
		"react-library.json"
	],
	"scripts": {
		"build": "tsup",
		"eslint": "eslint .",
		"eslint-fix": "eslint --fix .",
		"format:package": "sort-package-json",
		"format:package:check": "sort-package-json --check",
		"preinstall": "turbo run build --output-logs=errors-only"
	},
	"dependencies": {
		"@babel/core": "^7.23.5",
		"@swc/core": "^1.4.2",
		"esbuild": "^0.23.0",
		"ts-node": "^10.9.2",
		"tsup": "^8.0.2",
		"type-fest": "^4.10.3",
		"typescript": "^5.4.0"
	},
	"devDependencies": {
		"@types/node": "22.2.0"
	},
	"publishConfig": {
		"directory": "dist"
	}
}
