{
	"name": "@config/tsconfig",
	"version": "1.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "NODE_OPTIONS=\"--no-warnings\" tsup-node",
		"preinstall": "turbo run build --output-logs=errors-only"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"dependencies": {
		"@swc/core": "1.6.13",
		"ts-node": "10.9.2",
		"tsup": "8.1.0",
		"type-fest": "4.21.0",
		"typescript": "5.5.3"
	},
	"devDependencies": {
		"@types/node": "20.14.10"
	},
	"files": [
		"base.json",
		"commonjs.json",
		"ecma.json",
		"nextjs.json",
		"test.json"
	],
	"publishConfig": {
		"directory": "dist"
	}
}
