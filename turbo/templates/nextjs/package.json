{
	"name": "@template/nextjs",
	"description": "A template for creating a Next.JS app.",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"homepage": "https://github.com/spencerbeggs/turbo-template/turbo/generators/templates/nextjs#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/spencerbeggs/turbo-template.git"
	},
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beg.gs"
	},
	"keywords": [],
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "next build",
		"dev": "next dev --turbo --port 3000",
		"eslint": "eslint .",
		"eslint-fix": "eslint --fix .",
		"format:package": "sort-package-json",
		"format:package:check": "sort-package-json --check",
		"start": "next start",
		"test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' TS_JEST_DISABLE_VER_CHECKER=false pnpm exec jest --colors --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@tailwindcss/line-clamp": "^0.4.4",
		"@vercel/analytics": "^1.3.1",
		"@vercel/speed-insights": "^1.0.12",
		"next": "^14.2.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@config/tsconfig": "workspace:*",
		"@tailwindcss/aspect-ratio": "0.4.2",
		"@tailwindcss/container-queries": "0.1.1",
		"@tailwindcss/forms": "0.5.7",
		"@tailwindcss/line-clamp": "0.4.4",
		"@tailwindcss/typography": "0.5.14",
		"@turbo/gen": "^2.0.12",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"autoprefixer": "^10.4.20",
		"tailwindcss": "^3.4.9",
		"vercel": "^35.2.4"
	}
}
