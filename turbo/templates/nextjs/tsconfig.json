{
	"include": ["next-env.d.ts", "middleware.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "types/**/*.ts"],
	"exclude": ["node_modules", "dist", "build", ".turbo", ".next"],
	"compilerOptions": {
		"target": "es5",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@clients/*": ["./app/components/clients/*"],
			"@components/*": ["./app/components/base/*"],
			"@helpers/*": ["./app/components/helpers/*"],
			"@gadgets/*": ["./app/components/gadgets/*"],
			"@widgets/*": ["./app/components/widgets/*"],
			"@modules/*": ["./app/components/modules/*"],
			"@layouts/*": ["./app/components/layouts/*"],
			"@prebuilt/*": ["./app/prebuilt_modules//*"],
			"@hooks/*": ["./app/components/hooks/*"],
			"@resources/*": ["./app/resources/*"],
			"@vercel/analytics/react": ["./node_modules/@vercel/analytics/dist/react"]
		},
		"typeRoots": ["./node_modules/@types", "./types"]
	}
}
